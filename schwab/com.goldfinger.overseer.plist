<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.goldfinger.overseer</string>

  <!-- caffeinate -is keeps the machine awake while the overseer runs -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>/Users/lincai/anaconda3/envs/gold-finger-py312/bin/python</string>
    <string>-u</string>
    <string>schwab/real_overseer.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/lincai/dev/private/gold-finger</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <!-- Was the OLD gold-finger env while ProgramArguments runs
         gold-finger-py312: any subprocess resolving bare `python` from PATH
         got the wrong interpreter. Fixed 2026-10-12. -->
    <key>PATH</key>
    <string>/Users/lincai/anaconda3/envs/gold-finger-py312/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    <!-- The env loads THREE OpenMP runtimes in one process: torch's
         libomp.dylib, sklearn's libomp.dylib, and LightGBM's own. The
         overseer imports all three (TimesFM/Kronos, CalibratedClassifierCV in
         assignment_risk, LGBMClassifier), and on 2026-10-12 it died with
         SIGSEGV in libomp __kmp_suspend_initialize_thread during the
         LightGBM training that runs at every startup — launchd relaunched it
         twice in one morning with no Python traceback.
         Single-threaded OpenMP creates no worker pool, so there is no fork
         barrier and no suspend path to crash in. Costs some LightGBM/torch
         speed; training 14 symbols takes seconds either way. -->
    <key>OMP_NUM_THREADS</key>
    <string>1</string>
  </dict>

  <!-- start on login/boot -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Always keep the overseer running: restart on ANY exit, clean or crash.
       (SuccessfulExit=false left it DOWN when it exited 0 on the market-closed
       startup path.) The singleton lock still prevents a double-run; a lock-
       refused instance just exits and is retried after ThrottleInterval. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- append to the same log the status tool + skill already read -->
  <key>StandardOutPath</key>
  <string>/Users/lincai/dev/private/gold-finger/data/overseer.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lincai/dev/private/gold-finger/data/overseer.log</string>

  <!-- avoid App Nap / throttling for a 24x7 process -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
